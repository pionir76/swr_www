{
  "format": "whmi.screen",
  "version": "0.1",
  "id": "main",
  "title": "냉동 설비 통합 모니터링",
  "size": { "w": 1280, "h": 720 },
  "background": "#14181f",
  "widgets": [
    { "id": "title", "type": "label", "x": 20, "y": 12, "w": 800, "h": 36,
      "props": { "text": "냉동 설비 통합 모니터링", "fontSize": 24, "bold": true } },
    { "id": "nav_chiller", "type": "screenlink", "x": 1080, "y": 12, "w": 180, "h": 36,
      "props": { "text": "메인칠러 화면 →", "screen": "chiller", "color": "#2d6cdf" } },

    { "id": "pnl_sh", "type": "rect", "x": 20, "y": 60, "w": 420, "h": 320 },
    { "id": "lbl_sh", "type": "label", "x": 36, "y": 68, "w": 300, "h": 28,
      "props": { "text": "과열도 제어", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "g_sh", "type": "gauge", "x": 80, "y": 96, "w": 260, "h": 200, "tag": "SH_VALUE",
      "props": { "title": "과열도",
                 "ranges": [ { "to": 2, "color": "#e0a030" }, { "from": 20, "color": "#e5534b" } ] } },
    { "id": "lbl_sh_sp", "type": "label", "x": 80, "y": 304, "w": 200, "h": 18,
      "props": { "text": "과열도 설정값", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "in_sh_sp", "type": "input", "x": 80, "y": 326, "w": 200, "h": 44, "tag": "SH_SETPOINT" },

    { "id": "pnl_gauges", "type": "rect", "x": 460, "y": 60, "w": 460, "h": 320 },
    { "id": "lbl_gauges", "type": "label", "x": 476, "y": 68, "w": 300, "h": 28,
      "props": { "text": "공정 계기", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "g_sat", "type": "gauge", "x": 480, "y": 100, "w": 130, "h": 210, "tag": "SAT_TEMP",
      "props": { "title": "포화온도", "arcColor": "#36c5b0" } },
    { "id": "g_suct_p", "type": "gauge", "x": 615, "y": 100, "w": 130, "h": 210, "tag": "SUCTION_PRESS",
      "props": { "title": "흡입압력" } },
    { "id": "g_suct_t", "type": "gauge", "x": 750, "y": 100, "w": 130, "h": 210, "tag": "SUCTION_TEMP",
      "props": { "title": "흡입온도", "arcColor": "#36c5b0" } },

    { "id": "pnl_outlet", "type": "rect", "x": 940, "y": 60, "w": 320, "h": 320 },
    { "id": "lbl_outlet", "type": "label", "x": 956, "y": 68, "w": 280, "h": 28,
      "props": { "text": "액 출구", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_outlet_pv", "type": "label", "x": 960, "y": 104, "w": 200, "h": 18,
      "props": { "text": "현재 온도", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "num_outlet_pv", "type": "numeric", "x": 960, "y": 126, "w": 280, "h": 70, "tag": "LIQUID_OUTLET_TEMP" },
    { "id": "lbl_outlet_sp", "type": "label", "x": 960, "y": 214, "w": 200, "h": 18,
      "props": { "text": "설정값", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "in_outlet_sp", "type": "input", "x": 960, "y": 236, "w": 200, "h": 44, "tag": "LIQUID_OUTLET_SP" },

    { "id": "pnl_valve", "type": "rect", "x": 20, "y": 400, "w": 420, "h": 300 },
    { "id": "lbl_valve", "type": "label", "x": 36, "y": 408, "w": 300, "h": 28,
      "props": { "text": "밸브 제어", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_valve_pos", "type": "label", "x": 40, "y": 450, "w": 150, "h": 20,
      "props": { "text": "개도율", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "bar_valve_pos", "type": "bar", "x": 40, "y": 474, "w": 260, "h": 36, "tag": "VALVE_POS",
      "props": { "orientation": "h" } },
    { "id": "num_valve_pos", "type": "numeric", "x": 310, "y": 466, "w": 110, "h": 50, "tag": "VALVE_POS" },
    { "id": "lbl_manual_en", "type": "label", "x": 40, "y": 540, "w": 150, "h": 20,
      "props": { "text": "수동 밸브 사용", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "sw_manual_en", "type": "switch", "x": 40, "y": 564, "w": 110, "h": 40, "tag": "MANUAL_VALVE_EN" },
    { "id": "lbl_manual_pos", "type": "label", "x": 200, "y": 540, "w": 200, "h": 20,
      "props": { "text": "수동 밸브 위치", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "in_manual_pos", "type": "input", "x": 200, "y": 564, "w": 200, "h": 44, "tag": "MANUAL_VALVE_POS" },

    { "id": "pnl_system", "type": "rect", "x": 460, "y": 400, "w": 460, "h": 300 },
    { "id": "lbl_system", "type": "label", "x": 476, "y": 408, "w": 300, "h": 28,
      "props": { "text": "시스템 상태", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_sys_state", "type": "label", "x": 480, "y": 450, "w": 200, "h": 18,
      "props": { "text": "상태 코드", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "num_sys_state", "type": "numeric", "x": 480, "y": 472, "w": 140, "h": 50, "tag": "SYSTEM_STATE" },
    { "id": "lbl_alarm", "type": "label", "x": 480, "y": 550, "w": 200, "h": 18,
      "props": { "text": "알람 코드", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "num_alarm", "type": "numeric", "x": 480, "y": 572, "w": 140, "h": 50, "tag": "ALARM_STATUS",
      "props": { "color": "#ff8c91" } },
    { "id": "lmp_alarm", "type": "lamp", "x": 640, "y": 580, "w": 140, "h": 36, "tag": "ALARM_STATUS",
      "props": { "text": "알람", "onColor": "#e5534b" } },

    { "id": "pnl_comp", "type": "rect", "x": 940, "y": 400, "w": 320, "h": 300 },
    { "id": "lbl_comp", "type": "label", "x": 956, "y": 408, "w": 280, "h": 28,
      "props": { "text": "압축기", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_comp_temp", "type": "label", "x": 960, "y": 450, "w": 200, "h": 18,
      "props": { "text": "온도", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "num_comp_temp", "type": "numeric", "x": 960, "y": 472, "w": 200, "h": 60, "tag": "COMP_TEMP" },
    { "id": "lmp_comp_run", "type": "lamp", "x": 960, "y": 548, "w": 220, "h": 36, "tag": "COMP_RUN_STATUS",
      "props": { "text": "운전중", "bit": 0, "onValue": 0 } },
    { "id": "lbl_comp_cmd", "type": "label", "x": 960, "y": 600, "w": 300, "h": 18,
      "props": { "text": "기동 / 정지 / 토글(테스트)", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "btn_comp_on", "type": "button", "x": 960, "y": 624, "w": 85, "h": 44, "tag": "COMP_RUNSTOP",
      "props": { "text": "기동", "action": "set", "value": 0, "color": "#2b7a4b",
                 "confirm": "압축기를 기동하시겠습니까?" } },
    { "id": "btn_comp_off", "type": "button", "x": 1055, "y": 624, "w": 85, "h": 44, "tag": "COMP_RUNSTOP",
      "props": { "text": "정지", "action": "set", "value": 1, "color": "#8c2f2b",
                 "confirm": "압축기를 정지하시겠습니까?" } },
    { "id": "btn_comp_toggle", "type": "button", "x": 1150, "y": 624, "w": 85, "h": 44, "tag": "COMP_RUNSTOP",
      "props": { "text": "토글", "action": "toggle", "onValue": 0, "offValue": 1,
                 "onText": "운전", "offText": "정지",
                 "color": "#2d6cdf", "activeColor": "#2b7a4b" } }
  ]
}
