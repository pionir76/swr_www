{
  "format": "whmi.screen",
  "version": "0.1",
  "id": "chiller",
  "title": "메인칠러 모니터링",
  "size": { "w": 1280, "h": 720 },
  "background": "#14181f",
  "widgets": [
    { "id": "title", "type": "label", "x": 20, "y": 12, "w": 800, "h": 36,
      "props": { "text": "메인칠러 모니터링", "fontSize": 24, "bold": true } },
    { "id": "nav_main", "type": "screenlink", "x": 1080, "y": 12, "w": 180, "h": 36,
      "props": { "text": "← 메인 화면", "screen": "main", "color": "#2d6cdf" } },

    { "id": "pnl_temp", "type": "rect", "x": 20, "y": 60, "w": 420, "h": 320 },
    { "id": "lbl_temp", "type": "label", "x": 36, "y": 68, "w": 300, "h": 28,
      "props": { "text": "칠러 온도", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_temp_pv", "type": "label", "x": 40, "y": 104, "w": 200, "h": 18,
      "props": { "text": "현재온도", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "num_temp_pv", "type": "numeric", "x": 40, "y": 126, "w": 340, "h": 80, "tag": "CHILLER_TEMP" },
    { "id": "lbl_sp_now", "type": "label", "x": 40, "y": 224, "w": 200, "h": 18,
      "props": { "text": "현재설정값", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "num_sp_now", "type": "numeric", "x": 40, "y": 246, "w": 200, "h": 50, "tag": "CHILLER_SP_NOW" },

    { "id": "pnl_sp", "type": "rect", "x": 460, "y": 60, "w": 420, "h": 320 },
    { "id": "lbl_sp", "type": "label", "x": 476, "y": 68, "w": 300, "h": 28,
      "props": { "text": "설정값 변경", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_sp_target", "type": "label", "x": 480, "y": 104, "w": 200, "h": 18,
      "props": { "text": "목표설정값", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "in_sp_target", "type": "input", "x": 480, "y": 126, "w": 200, "h": 50, "tag": "CHILLER_SP_TARGET" },

    { "id": "pnl_run", "type": "rect", "x": 900, "y": 60, "w": 360, "h": 320 },
    { "id": "lbl_run", "type": "label", "x": 916, "y": 68, "w": 300, "h": 28,
      "props": { "text": "운전 제어", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lmp_run", "type": "lamp", "x": 920, "y": 110, "w": 220, "h": 36, "tag": "CHILLER_RUN_STATUS",
      "props": { "text": "운전중", "bit": 0, "onValue": 0 } },
    { "id": "lbl_run_cmd", "type": "label", "x": 920, "y": 170, "w": 300, "h": 18,
      "props": { "text": "기동 / 정지 / 토글(테스트)", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "btn_run_on", "type": "button", "x": 920, "y": 194, "w": 95, "h": 44, "tag": "CHILLER_RUNSTOP",
      "props": { "text": "기동", "action": "set", "value": 0, "color": "#2b7a4b",
                 "confirm": "메인칠러를 기동하시겠습니까?" } },
    { "id": "btn_run_off", "type": "button", "x": 1025, "y": 194, "w": 95, "h": 44, "tag": "CHILLER_RUNSTOP",
      "props": { "text": "정지", "action": "set", "value": 1, "color": "#8c2f2b",
                 "confirm": "메인칠러를 정지하시겠습니까?" } },
    { "id": "btn_run_toggle", "type": "button", "x": 1130, "y": 194, "w": 95, "h": 44, "tag": "CHILLER_RUNSTOP",
      "props": { "text": "토글", "action": "toggle", "onValue": 0, "offValue": 1,
                 "onText": "운전", "offText": "정지", "color": "#2d6cdf", "activeColor": "#2b7a4b" } },

    { "id": "pnl_mode", "type": "rect", "x": 20, "y": 400, "w": 420, "h": 300 },
    { "id": "lbl_mode", "type": "label", "x": 36, "y": 408, "w": 300, "h": 28,
      "props": { "text": "제어모드", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_mode_sw", "type": "label", "x": 40, "y": 450, "w": 200, "h": 18,
      "props": { "text": "자동 / 수동", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "btn_mode_toggle", "type": "button", "x": 40, "y": 474, "w": 130, "h": 44, "tag": "CHILLER_AUTO_MAN",
      "props": { "text": "토글", "action": "toggle", "onValue": 0, "offValue": 1,
                 "onText": "자동", "offText": "수동", "color": "#2d6cdf", "activeColor": "#2b7a4b" } },
    { "id": "lmp_mode_status", "type": "lamp", "x": 200, "y": 474, "w": 220, "h": 44, "tag": "CHILLER_MODE_STATUS",
      "props": { "text": "수동 모드(실제 확인)", "bit": 13, "onValue": 1, "onColor": "#3fa7ff" } },

    { "id": "pnl_out", "type": "rect", "x": 460, "y": 400, "w": 420, "h": 300 },
    { "id": "lbl_out", "type": "label", "x": 476, "y": 408, "w": 300, "h": 28,
      "props": { "text": "출력량", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_mvout", "type": "label", "x": 480, "y": 450, "w": 260, "h": 18,
      "props": { "text": "수동출력 설정 (수동 모드일 때만 입력 가능)", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "in_mvout", "type": "input", "x": 480, "y": 472, "w": 200, "h": 50, "tag": "CHILLER_MVOUT",
      "enableWhen": { "tag": "CHILLER_AUTO_MAN", "equals": 1 } },
    { "id": "lbl_mv", "type": "label", "x": 480, "y": 544, "w": 200, "h": 18,
      "props": { "text": "현재 출력량", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "g_mv", "type": "gauge", "x": 500, "y": 560, "w": 200, "h": 130, "tag": "CHILLER_MV",
      "props": { "title": "제어출력량", "arcColor": "#36c5b0" } }
  ]
}
