{
  "format": "whmi.screen",
  "version": "0.1",
  "id": "chiller",
  "title": "메인칠러 모니터링",
  "size": { "w": 1280, "h": 720 },
  "background": "#14181f",
  "widgets": [
    { "id": "title", "type": "label", "x": 20, "y": 12, "w": 800, "h": 36,
      "props": { "text": "메인칠러 모니터링", "fontSize": 24, "bold": true } },
    { "id": "nav_main", "type": "screenlink", "x": 1080, "y": 12, "w": 180, "h": 36,
      "props": { "text": "← 메인 화면", "screen": "main", "color": "#2d6cdf" } },

    { "id": "pnl_temp", "type": "rect", "x": 20, "y": 60, "w": 420, "h": 320 },
    { "id": "lbl_temp", "type": "label", "x": 36, "y": 68, "w": 300, "h": 28,
      "props": { "text": "칠러 온도", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_temp_pv", "type": "label", "x": 40, "y": 104, "w": 200, "h": 18,
      "props": { "text": "현재온도", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "num_temp_pv", "type": "numeric", "x": 40, "y": 124, "w": 340, "h": 62, "tag": "CHILLER_TEMP" },
    { "id": "lbl_sp_now", "type": "label", "x": 40, "y": 194, "w": 200, "h": 18,
      "props": { "text": "현재설정값", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "num_sp_now", "type": "numeric", "x": 40, "y": 214, "w": 200, "h": 44, "tag": "CHILLER_SP_NOW" },

    { "id": "nm_mv1", "type": "numeric", "x": 40, "y": 268, "w": 180, "h": 48, "tag": "CHILLER_MV",
      "props": { "preset": "led", "caption": "MV · LED", "fontSize": 22 } },
    { "id": "nm_mv2", "type": "numeric", "x": 230, "y": 268, "w": 180, "h": 48, "tag": "CHILLER_MV",
      "props": { "preset": "lcd", "caption": "MV · LCD", "fontSize": 22 } },
    { "id": "nm_mv3", "type": "numeric", "x": 40, "y": 324, "w": 180, "h": 48, "tag": "CHILLER_MV",
      "props": { "preset": "vfd", "caption": "MV · 카운트·깜빡임·추세", "fontSize": 22,
                 "animMs": 600, "flashOnChange": true, "showTrend": true } },
    { "id": "nm_mv4", "type": "numeric", "x": 230, "y": 324, "w": 180, "h": 48, "tag": "CHILLER_MV",
      "props": { "caption": "MV · 경보배경·입체", "fontSize": 22, "font": "sans", "align": "center",
                 "radius": 10, "borderWidth": 2, "border": "#4a5566", "bevel": true, "glass": true,
                 "rangeTarget": "bg",
                 "ranges": [ { "from": 25, "to": 60, "color": "#7a5414" }, { "from": 60, "color": "#8c2f2b", "blink": true } ] } },

    { "id": "pnl_sp", "type": "rect", "x": 460, "y": 60, "w": 420, "h": 320 },
    { "id": "lbl_sp", "type": "label", "x": 476, "y": 68, "w": 300, "h": 28,
      "props": { "text": "설정값 변경", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_sp_sel", "type": "label", "x": 480, "y": 104, "w": 180, "h": 18,
      "props": { "text": "SP 선택", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "sel_sp", "type": "selector", "x": 476, "y": 118, "w": 190, "h": 150, "tag": "CHILLER_SP_SEL",
      "props": { "startAngle": -60, "endAngle": 60,
                 "options": [ { "value": 1, "text": "SP1" }, { "value": 2, "text": "SP2" }, { "value": 3, "text": "SP3" } ] } },

    { "id": "lbl_sp_vals", "type": "label", "x": 680, "y": 104, "w": 190, "h": 18,
      "props": { "text": "목표설정값 (● 현재 선택)", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "lmp_sp1", "type": "lamp", "x": 680, "y": 140, "w": 64, "h": 24, "tag": "CHILLER_SP_SEL",
      "props": { "text": "SP1", "onValue": 1 } },
    { "id": "in_sp1", "type": "input", "x": 750, "y": 130, "w": 118, "h": 44, "tag": "CHILLER_SP1" },
    { "id": "lmp_sp2", "type": "lamp", "x": 680, "y": 200, "w": 64, "h": 24, "tag": "CHILLER_SP_SEL",
      "props": { "text": "SP2", "onValue": 2 } },
    { "id": "in_sp2", "type": "input", "x": 750, "y": 190, "w": 118, "h": 44, "tag": "CHILLER_SP2" },
    { "id": "lmp_sp3", "type": "lamp", "x": 680, "y": 260, "w": 64, "h": 24, "tag": "CHILLER_SP_SEL",
      "props": { "text": "SP3", "onValue": 3 } },
    { "id": "in_sp3", "type": "input", "x": 750, "y": 250, "w": 118, "h": 44, "tag": "CHILLER_SP3" },

    { "id": "pnl_run", "type": "rect", "x": 900, "y": 60, "w": 360, "h": 320 },
    { "id": "lbl_run", "type": "label", "x": 916, "y": 68, "w": 300, "h": 28,
      "props": { "text": "운전 제어", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lmp_run", "type": "lamp", "x": 920, "y": 110, "w": 220, "h": 36, "tag": "CHILLER_RUN_STATUS",
      "props": { "text": "운전중", "bit": 0, "onValue": 0 } },
    { "id": "lbl_run_cmd", "type": "label", "x": 920, "y": 170, "w": 300, "h": 18,
      "props": { "text": "기동 / 정지 / 토글(테스트)", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "btn_run_on", "type": "button", "x": 920, "y": 194, "w": 95, "h": 44, "tag": "CHILLER_RUNSTOP",
      "props": { "text": "기동", "action": "set", "value": 0, "color": "#2b7a4b",
                 "confirm": "메인칠러를 기동하시겠습니까?" } },
    { "id": "btn_run_off", "type": "button", "x": 1025, "y": 194, "w": 95, "h": 44, "tag": "CHILLER_RUNSTOP",
      "props": { "text": "정지", "action": "set", "value": 1, "color": "#8c2f2b",
                 "confirm": "메인칠러를 정지하시겠습니까?" } },
    { "id": "btn_run_toggle", "type": "button", "x": 1130, "y": 194, "w": 95, "h": 44, "tag": "CHILLER_RUNSTOP",
      "props": { "text": "토글", "action": "toggle", "onValue": 0, "offValue": 1,
                 "onText": "운전", "offText": "정지", "color": "#2d6cdf", "activeColor": "#2b7a4b" } },

    { "id": "pnl_mode", "type": "rect", "x": 20, "y": 400, "w": 420, "h": 300 },
    { "id": "lbl_mode", "type": "label", "x": 36, "y": 408, "w": 300, "h": 28,
      "props": { "text": "제어모드", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_mode_sw", "type": "label", "x": 40, "y": 450, "w": 200, "h": 18,
      "props": { "text": "① 토글 버튼", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "btn_mode_toggle", "type": "button", "x": 40, "y": 474, "w": 130, "h": 44, "tag": "CHILLER_AUTO_MAN",
      "props": { "text": "토글", "action": "toggle", "onValue": 0, "offValue": 1,
                 "onText": "자동", "offText": "수동", "color": "#2d6cdf", "activeColor": "#2b7a4b" } },
    { "id": "lmp_mode_status", "type": "lamp", "x": 200, "y": 474, "w": 220, "h": 44, "tag": "CHILLER_MODE_STATUS",
      "props": { "text": "수동 모드(실제 확인)", "bit": 13, "onValue": 1, "onColor": "#3fa7ff" } },
    { "id": "lbl_mode_switch", "type": "label", "x": 40, "y": 548, "w": 140, "h": 18,
      "props": { "text": "② 스위치", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "sw_mode", "type": "switch", "x": 40, "y": 574, "w": 120, "h": 44, "tag": "CHILLER_AUTO_MAN",
      "props": { "onValue": 0, "offValue": 1, "onText": "AUTO", "offText": "MAN",
                 "onColor": "#2b7a4b", "offColor": "#2d6cdf" } },
    { "id": "lbl_mode_selector", "type": "label", "x": 200, "y": 548, "w": 200, "h": 18,
      "props": { "text": "③ 로터리 셀렉터", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "sel_mode", "type": "selector", "x": 200, "y": 572, "w": 200, "h": 110, "tag": "CHILLER_AUTO_MAN",
      "props": { "options": [ { "value": 0, "text": "자동" }, { "value": 1, "text": "수동" } ] } },

    { "id": "pnl_out", "type": "rect", "x": 460, "y": 400, "w": 420, "h": 300 },
    { "id": "lbl_out", "type": "label", "x": 476, "y": 408, "w": 300, "h": 28,
      "props": { "text": "출력량", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_mvout", "type": "label", "x": 480, "y": 450, "w": 260, "h": 18,
      "props": { "text": "수동출력 설정 (수동 모드일 때만 입력 가능)", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "in_mvout", "type": "input", "x": 480, "y": 472, "w": 200, "h": 50, "tag": "CHILLER_MVOUT",
      "enableWhen": { "tag": "CHILLER_AUTO_MAN", "equals": 1 } },
    { "id": "lbl_mv", "type": "label", "x": 480, "y": 544, "w": 200, "h": 18,
      "props": { "text": "현재 출력량", "fontSize": 13, "color": "#8a93a3" } },
    { "id": "g_mv", "type": "gauge", "x": 500, "y": 560, "w": 200, "h": 130, "tag": "CHILLER_MV",
      "props": { "title": "제어출력량", "arcColor": "#36c5b0", "lineCap": "round" } },

    { "id": "pnl_barsample", "type": "rect", "x": 900, "y": 400, "w": 360, "h": 300 },
    { "id": "lbl_barsample", "type": "label", "x": 916, "y": 408, "w": 300, "h": 28,
      "props": { "text": "바 위젯 샘플", "fontSize": 16, "color": "#8a93a3" } },

    { "id": "lbl_bs1", "type": "label", "x": 920, "y": 440, "w": 250, "h": 16,
      "props": { "text": "① 눈금·보조눈금·값 왼쪽 정렬", "fontSize": 12, "color": "#8a93a3" } },
    { "id": "bar_bs1", "type": "bar", "x": 920, "y": 458, "w": 250, "h": 46, "tag": "CHILLER_MV",
      "props": { "orientation": "h", "thickness": 18, "showScale": true, "ticks": 5, "minorTicks": 4, "showValue": true, "valueAlign": "start" } },

    { "id": "lbl_bs2", "type": "label", "x": 920, "y": 512, "w": 250, "h": 16,
      "props": { "text": "② 그라데이션 + 음영 · 값 가운데", "fontSize": 12, "color": "#8a93a3" } },
    { "id": "bar_bs2", "type": "bar", "x": 920, "y": 530, "w": 250, "h": 24, "tag": "CHILLER_MV",
      "props": { "orientation": "h", "shade": true, "showValue": true, "valueAlign": "center",
                 "gradient": [ { "at": 0, "color": "#2ecc71" }, { "at": 60, "color": "#e0a030" }, { "at": 100, "color": "#e5534b" } ] } },

    { "id": "lbl_bs3", "type": "label", "x": 920, "y": 566, "w": 250, "h": 16,
      "props": { "text": "③ 영점 기준 · 값이 막대 끝을 따라감", "fontSize": 12, "color": "#8a93a3" } },
    { "id": "bar_bs3", "type": "bar", "x": 920, "y": 584, "w": 250, "h": 40, "tag": "CHILLER_TEMP",
      "props": { "orientation": "h", "thickness": 18, "min": -50, "max": 100, "origin": 0,
                 "showMinMax": true, "showValue": true, "valueAlign": "follow", "markers": [ { "value": 0 } ],
                 "ranges": [ { "to": 0, "color": "#3fa7ff" }, { "from": 0, "color": "#e0a030" } ] } },

    { "id": "lbl_bs4", "type": "label", "x": 1185, "y": 440, "w": 70, "h": 16,
      "props": { "text": "④ 세로", "fontSize": 12, "color": "#8a93a3" } },
    { "id": "bar_bs4", "type": "bar", "x": 1190, "y": 462, "w": 60, "h": 220, "tag": "CHILLER_MV",
      "props": { "orientation": "v", "thickness": 22, "showScale": true, "ticks": 6, "showRanges": true,
                 "ranges": [ { "from": 60, "to": 80, "color": "#e0a030" }, { "from": 80, "color": "#e5534b" } ],
                 "markers": [ { "value": 80, "color": "#e5534b" } ] } }
  ]
}
