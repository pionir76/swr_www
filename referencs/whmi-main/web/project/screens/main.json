{
  "format": "whmi.screen",
  "version": "0.1",
  "id": "main",
  "title": "1공장 용수 설비 모니터링",
  "size": { "w": 1280, "h": 720 },
  "background": "#14181f",
  "widgets": [
    { "id": "title", "type": "label", "x": 20, "y": 12, "w": 800, "h": 36,
      "props": { "text": "1공장 용수 설비 모니터링", "fontSize": 24, "bold": true } },

    { "id": "pnl_tank", "type": "rect", "x": 20, "y": 60, "w": 560, "h": 440 },
    { "id": "lbl_tank", "type": "label", "x": 36, "y": 68, "w": 200, "h": 28,
      "props": { "text": "저수 탱크", "fontSize": 16, "color": "#8a93a3" } },

    { "id": "tk1", "type": "tank", "x": 50, "y": 110, "w": 150, "h": 290, "tag": "TK1_LEVEL",
      "props": { "ranges": [ { "from": 90, "color": "#e5534b" }, { "to": 15, "color": "#e0a030" } ] } },
    { "id": "lbl_tk1", "type": "label", "x": 30, "y": 410, "w": 156, "h": 24,
      "props": { "text": "1번 탱크", "align": "center" } },
    { "id": "num_tk1", "type": "numeric", "x": 30, "y": 440, "w": 156, "h": 44, "tag": "TK1_LEVEL" },

    { "id": "tk2", "type": "tank", "x": 230, "y": 110, "w": 150, "h": 290, "tag": "TK2_LEVEL",
      "props": { "fillColor": "#36c5b0" } },
    { "id": "lbl_tk2", "type": "label", "x": 210, "y": 410, "w": 156, "h": 24,
      "props": { "text": "2번 탱크", "align": "center" } },
    { "id": "num_tk2", "type": "numeric", "x": 210, "y": 440, "w": 156, "h": 44, "tag": "TK2_LEVEL" },

    { "id": "lmp_hi", "type": "lamp", "x": 410, "y": 115, "w": 160, "h": 28, "tag": "ALARM_HI",
      "props": { "text": "고수위 경보", "onColor": "#e5534b", "blink": true } },
    { "id": "lbl_sp", "type": "label", "x": 410, "y": 170, "w": 160, "h": 22,
      "props": { "text": "수위 설정값", "fontSize": 14, "color": "#8a93a3" } },
    { "id": "in_sp", "type": "input", "x": 410, "y": 196, "w": 150, "h": 44, "tag": "LEVEL_SP" },

    { "id": "pnl_gauge", "type": "rect", "x": 600, "y": 60, "w": 660, "h": 270 },
    { "id": "lbl_gauge", "type": "label", "x": 616, "y": 68, "w": 200, "h": 28,
      "props": { "text": "공정 계기", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "g_press", "type": "gauge", "x": 620, "y": 100, "w": 200, "h": 220, "tag": "LINE_PRESS",
      "props": { "title": "토출 압력",
                 "ranges": [ { "to": 2, "color": "#e0a030" }, { "from": 8, "color": "#e5534b" } ] } },
    { "id": "g_temp", "type": "gauge", "x": 840, "y": 100, "w": 200, "h": 220, "tag": "TK1_TEMP",
      "props": { "title": "탱크 온도", "arcColor": "#36c5b0",
                 "ranges": [ { "from": 80, "color": "#e5534b" } ] } },
    { "id": "g_flow", "type": "gauge", "x": 1060, "y": 100, "w": 200, "h": 220, "tag": "FLOW_RATE",
      "props": { "title": "토출 유량" } },

    { "id": "pnl_pump", "type": "rect", "x": 600, "y": 345, "w": 660, "h": 155 },
    { "id": "lbl_pump", "type": "label", "x": 616, "y": 353, "w": 200, "h": 28,
      "props": { "text": "펌프 제어", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lmp_p1", "type": "lamp", "x": 620, "y": 395, "w": 140, "h": 30, "tag": "PUMP1_RUN",
      "props": { "text": "P1 운전" } },
    { "id": "btn_p1_on", "type": "button", "x": 780, "y": 390, "w": 100, "h": 40, "tag": "PUMP1_CMD",
      "props": { "text": "기동", "action": "set", "value": true, "color": "#2b7a4b" } },
    { "id": "btn_p1_off", "type": "button", "x": 890, "y": 390, "w": 100, "h": 40, "tag": "PUMP1_CMD",
      "props": { "text": "정지", "action": "set", "value": false, "color": "#8c2f2b",
                 "confirm": "P1 펌프를 정지하시겠습니까?" } },
    { "id": "lmp_p2", "type": "lamp", "x": 620, "y": 450, "w": 140, "h": 30, "tag": "PUMP2_RUN",
      "props": { "text": "P2 운전" } },
    { "id": "sw_p2", "type": "switch", "x": 780, "y": 447, "w": 96, "h": 36, "tag": "PUMP2_CMD",
      "props": { "confirm": "P2 펌프 운전 상태를 변경하시겠습니까?" } },

    { "id": "pnl_bottom", "type": "rect", "x": 20, "y": 515, "w": 1240, "h": 185 },
    { "id": "lbl_bottom", "type": "label", "x": 36, "y": 523, "w": 300, "h": 28,
      "props": { "text": "모터 / 유량", "fontSize": 16, "color": "#8a93a3" } },
    { "id": "lbl_rpm", "type": "label", "x": 40, "y": 565, "w": 140, "h": 30,
      "props": { "text": "P1 회전수" } },
    { "id": "bar_rpm", "type": "bar", "x": 190, "y": 565, "w": 800, "h": 30, "tag": "MOTOR_RPM",
      "props": { "orientation": "h", "ranges": [ { "from": 1600, "color": "#e5534b" } ] } },
    { "id": "num_rpm", "type": "numeric", "x": 1010, "y": 558, "w": 230, "h": 44, "tag": "MOTOR_RPM" },
    { "id": "lbl_flow", "type": "label", "x": 40, "y": 635, "w": 140, "h": 30,
      "props": { "text": "토출 유량" } },
    { "id": "bar_flow", "type": "bar", "x": 190, "y": 635, "w": 800, "h": 30, "tag": "FLOW_RATE",
      "props": { "orientation": "h", "fillColor": "#36c5b0" } },
    { "id": "num_flow", "type": "numeric", "x": 1010, "y": 628, "w": 230, "h": 44, "tag": "FLOW_RATE" }
  ]
}
